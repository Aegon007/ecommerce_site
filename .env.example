# Local defaults. Copy to .env; existing process variables take precedence.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DB_PATH=data/ecommerce.db

# Used only when creating the first admin account in a NEW database.
# Existing databases keep their password; change it in the store manager.
# Set a unique value of at least 12 characters for a production database.
# ADMIN_PASSWORD=

# Seed sample products, reviews and demo orders only into an empty database.
# Default: true in development, false in production.
# SEED_DEMO_DATA=true

# Store pricing (USD); the same values are used on client and server.
TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=75.00
STANDARD_SHIPPING_FEE=7.99

# Demo orders only. No card details are collected and no money is charged.
# Other modes disable checkout until a real provider integration is implemented.
PAYMENT_MODE=mock
