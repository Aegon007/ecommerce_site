# Local defaults. Copy to .env; existing process variables take precedence.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DB_PATH=data/ecommerce.db

# Public origin for production, without a path. The reverse proxy serves HTTPS.
# APP_ORIGIN=https://www.example.com
# Enable only when the Node port is private and the proxy overwrites X-Real-IP.
TRUST_PROXY=false

# Used only when creating the first admin account in a NEW database.
# Existing databases keep their password; change it in the store manager.
# Set a unique value of at least 12 characters for a production database.
# ADMIN_PASSWORD=

# Seed sample products, reviews and demo orders only into an empty database.
# Default: true in development, false in production.
# SEED_DEMO_DATA=true

# Store pricing (USD); the same values are used on client and server.
TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=75.00
STANDARD_SHIPPING_FEE=7.99

# The public site is a catalog with inquiries. Enable legacy demo checkout for local testing only.
ENABLE_DEMO_CHECKOUT=false
PAYMENT_MODE=mock

# Inquiry notifications. Use a verified sender and the team mailbox that should receive inquiries.
# Without SMTP, inquiries are saved in the admin inbox and can be emailed later.
# INQUIRY_TO=sales@example.com
# INQUIRY_FROM=website@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Port 465 uses implicit TLS by default. Other ports require STARTTLS.
# SMTP_SECURE=false
